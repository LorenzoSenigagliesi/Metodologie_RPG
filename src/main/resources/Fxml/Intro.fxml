<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.RPG122755.controller.IntroController">

    <VBox alignment="CENTER" maxWidth="800.0" spacing="40.0">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <Label fx:id="LabelTesto" alignment="CENTER" prefHeight="220.0" prefWidth="717.0" text="" textFill="WHITE" wrapText="true">
            <font>
                <Font name="Courier New" size="22.0" />
            </font>
        </Label>

        <Button fx:id="btnAvanti" onAction="#avanti" prefHeight="33.0" prefWidth="200.0" style="-fx-background-color: #1e1e1e; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-color: #58a6ff; -fx-border-radius: 8; -fx-border-width: 1; -fx-cursor: hand;" text="Continua" textFill="WHITE" visible="false">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Button>

    </VBox>

</StackPane>
