<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<!--
    Seminterrato.fxml — Schermata dialogo / scena narrativa
    • imgScena   : ImageView intercambiabile (tutta la finestra)
    • lblTesto   : testo del dialogo/narrazione
    • btnAvanti  : bottone per avanzare nella storia
-->
<StackPane prefHeight="720.0" prefWidth="1080.0"
           style="-fx-background-color: #000000;"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.RPG122755.controller.SeminterratoController">

    <!-- ── IMMAGINE A SCHERMO INTERO (intercambiabile via controller) ── -->
    <ImageView fx:id="imgScena"
               fitWidth="1080.0"
               fitHeight="720.0"
               preserveRatio="false"
               pickOnBounds="true"
               smooth="true" />

    <!-- ── OVERLAY: AnchorPane per ancorare la barra al fondo ── -->
    <AnchorPane>

        <!-- Striscia nera con testo e bottone, ancorata in basso -->
        <HBox fx:id="barraDialogo"
              alignment="CENTER_LEFT"
              minHeight="130.0"
              prefWidth="1080.0"
              style="-fx-background-color: rgba(0,0,0,0.82);"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets bottom="22.0" left="35.0" right="35.0" top="22.0" />
            </padding>

            <!-- Testo del dialogo / narrazione -->
            <Label fx:id="LabelTesto"
                   text="Testo della scena o del dialogo..."
                   textFill="WHITE"
                   wrapText="true"
                   HBox.hgrow="ALWAYS">
                <font>
                    <Font name="System" size="19.0" />
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Bottone Avanti -->
            <Button fx:id="btnAvanti"
                    text="Avanti  ▶"
                    onAction="#Avanti"
                    prefWidth="130.0"
                    prefHeight="44.0"
                    style="-fx-background-color: #ffffff;
                           -fx-text-fill: #000000;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Button>
        </HBox>

    </AnchorPane>

</StackPane>
