<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unicam.cs.mpgc.RPG122755.controller.SeminterratoController">

    <!-- Immagine intercambiabile che occupa tutta la scena -->
    <center>
        <StackPane style="-fx-background-color: #000000;">
            <ImageView fx:id="imgScena"
                       fitWidth="1080.0"
                       fitHeight="720.0"
                       preserveRatio="true"
                       pickOnBounds="true"
                       smooth="true" />
        </StackPane>
    </center>

    <!-- Striscia nera in basso con testo e bottone -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              minHeight="120.0"
              style="-fx-background-color: rgba(0,0,0,0.88); -fx-border-color: #333333; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>

            <!-- Testo della scena / dialogo -->
            <Label fx:id="lblTesto"
                   text="Testo della scena o del dialogo..."
                   textFill="WHITE"
                   wrapText="true"
                   HBox.hgrow="ALWAYS">
                <font>
                    <Font name="System" size="18.0" />
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Bottone per andare avanti -->
            <Button fx:id="btnAvanti"
                    text="Avanti  ▶"
                    onAction="#onAvanti"
                    style="-fx-background-color: #ffffff;
                           -fx-text-fill: #000000;
                           -fx-background-radius: 6;
                           -fx-padding: 10 24 10 24;
                           -fx-cursor: hand;">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Button>
        </HBox>
    </bottom>

</BorderPane>
